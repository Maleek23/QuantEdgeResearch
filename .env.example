# ========================================
# QUANT EDGE LABS - REQUIRED ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in the values
# Get these from Replit Secrets tab

# ========================================
# DATABASE (REQUIRED - App will crash without this)
# ========================================
DATABASE_URL=postgresql://username:password@host:5432/database

# ========================================
# SESSION (REQUIRED)
# ========================================
SESSION_SECRET=your-random-secret-here

# ========================================
# MARKET DATA APIs (REQUIRED for stock analysis)
# ========================================
TRADIER_API_KEY=your-tradier-api-key
TRADIER_ACCOUNT_ID=your-tradier-account-id
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# ========================================
# AI PROVIDERS (At least ONE required for AI analysis)
# ========================================
# Anthropic Claude (Primary)
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI GPT (Backup)
OPENAI_API_KEY=your-openai-key

# Google Gemini (FREE - 1500 req/day)
GEMINI_API_KEY=your-gemini-key

# Groq (FREE - 14,400 req/day - FASTEST)
GROQ_API_KEY=your-groq-key

# Mistral (FREE - 1B tokens/month)
MISTRAL_API_KEY=your-mistral-key

# Grok
GROK_API_KEY=your-grok-key

# ========================================
# OPTIONAL INTEGRATIONS
# ========================================
# TradingView alerts → QuantEdge validation/paper pipeline
TRADINGVIEW_WEBHOOK_SECRET=generate-a-long-random-token
# Account-fit limits used by SPX/SPY 0DTE contract selection
INDEX_0DTE_ACCOUNT_SIZE=10000
INDEX_0DTE_RISK_BUDGET=250
INDEX_0DTE_MAX_DEBIT=300

# Discord Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_GAINS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CHARTANALYSIS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_FUTURE_TRADES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_QUANTFLOOR=https://discord.com/api/webhooks/...
# Optional: dedicated channel for manual Trade Desk "Share card" image posts (overrides asset-type routing)
DISCORD_WEBHOOK_TRADEDESK_CARD=https://discord.com/api/webhooks/...

# Email (Resend)
RESEND_API_KEY=your-resend-key

# Notion
NOTION_API_KEY=your-notion-key
NOTION_DATABASE_ID=your-notion-db-id

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin Access
ADMIN_ACCESS_CODE=your-admin-code
ADMIN_PASSWORD=your-admin-password

# ========================================
# DATA PROVIDERS (Optional but recommended)
# ========================================
DATABENTO_API_KEY=your-databento-key
OPENROUTER_API_KEY=your-openrouter-key
CEREBRAS_API_KEY=your-cerebras-key

# Journals (2026-09-29)
# 32 bytes (64 hex chars) sealing per-user broker keys at rest — required for "Connect Alpaca".
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKER_CREDENTIALS_KEY=
# Optional: read a trader's Discord channel server-side (docs/DISCORD_IMPORT.md). Read-only; file import works without it.
DISCORD_BOT_TOKEN=

# ── Loss rules v1 (shared/loss-rules.ts) — every rule defaults ON ─────────
# Unset = default. "off"/"false"/"0" disables. Report: GET /api/journal/loss-rules?journal=desk|bot
# LOSS_RULES=on                      # master switch for all five
# LOSS_RULE_BOT_CONFLUENCE=on        # 1. bot needs >=2 independent evidence families
# LOSS_RULE_MIN_SOURCES=2
# LOSS_RULE_BOT_ENTRY_WINDOW=on      # 2. bot entries only inside the window; stale-close ideas need a next-session trigger
# LOSS_RULE_ENTRY_WINDOW=09:30-11:30
# LOSS_RULE_TARGET_CAP=on            # 3a. new ideas: T1 <= mult x horizon expected move (20d realized vol)
# LOSS_RULE_TARGET_CAP_MULT=1
# LOSS_RULE_TIME_STOP=on             # 3b. exit at fraction of horizon unless >= min R in profit
# LOSS_RULE_TIME_STOP_FRACTION=0.5
# LOSS_RULE_TIME_STOP_MIN_R=0.5
# LOSS_RULE_DTE_FIT=on               # 4. multi-day holds (>= LOSS_RULE_MULTIDAY_DAYS) use 30-60 DTE
# LOSS_RULE_MULTIDAY_DAYS=3
# LOSS_RULE_MULTIDAY_DTE_MIN=30
# LOSS_RULE_MULTIDAY_DTE_MAX=60
