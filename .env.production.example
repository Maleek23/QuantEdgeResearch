# QuantEdge — production environment
# Copy the KEYS, never the values, into your host's secret manager.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/postgres
SESSION_SECRET=            # 64+ random bytes. Rotating it logs everyone out.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# ── Tier roles ──────────────────────────────────────────────────────────────
# Set ONLY on the web service. Tells web that a worker owns background jobs so
# the two tiers stop running the same schedules. Omit it if you deploy web
# alone — web then takes the scheduler lock itself.
WORKER_ENABLED=true

# Belt and braces for the same thing on the web tier.
DISABLE_WEB_FLOW_CRON=1

# Escape hatches (leave unset normally):
#   DISABLE_SCHEDULERS=true   this process runs no background jobs at all
#   SCHEDULER_LOCK=off        skip the advisory lock (single instance ONLY)

# ── Connection pool ─────────────────────────────────────────────────────────
# Must stay under the provider's ceiling ACROSS ALL INSTANCES. Supabase's
# pooler caps at 15, so 2 web + 1 worker at 12 each would exceed it — size it
# as (cap - 2) / instance_count. See server/db.ts.
DB_POOL_MAX=12

# ── Market data ─────────────────────────────────────────────────────────────
POLYGON_API_KEY=
FINNHUB_API_KEY=
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
TRADIER_USE_SANDBOX=false
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── TradingView webhook (validation + paper only) ──────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=
INDEX_0DTE_ACCOUNT_SIZE=10000
INDEX_0DTE_RISK_BUDGET=250
INDEX_0DTE_MAX_DEBIT=300

# ── Loss rules v1 (shared/loss-rules.ts) — every rule defaults ON ─────────
# Unset = default. "off"/"false"/"0" disables. Report: GET /api/journal/loss-rules?journal=desk|bot
# LOSS_RULES=on                      # master switch for all five
# LOSS_RULE_BOT_CONFLUENCE=on        # 1. bot needs >=2 independent evidence families
# LOSS_RULE_MIN_SOURCES=2
# LOSS_RULE_BOT_ENTRY_WINDOW=on      # 2. bot entries only inside the window; stale-close ideas need a next-session trigger
# LOSS_RULE_ENTRY_WINDOW=09:30-11:30
# LOSS_RULE_TARGET_CAP=on            # 3a. new ideas: T1 <= mult x horizon expected move (20d realized vol)
# LOSS_RULE_TARGET_CAP_MULT=1
# LOSS_RULE_TIME_STOP=on             # 3b. exit at fraction of horizon unless >= min R in profit
# LOSS_RULE_TIME_STOP_FRACTION=0.5
# LOSS_RULE_TIME_STOP_MIN_R=0.5
# LOSS_RULE_DTE_FIT=on               # 4. multi-day holds (>= LOSS_RULE_MULTIDAY_DAYS) use 30-60 DTE
# LOSS_RULE_MULTIDAY_DAYS=3
# LOSS_RULE_MULTIDAY_DTE_MIN=30
# LOSS_RULE_MULTIDAY_DTE_MAX=60
